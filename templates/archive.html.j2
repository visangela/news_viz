<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>历史归档 · AI 产业情报局</title>
<script>
  (function(){
    try {
      var saved = localStorage.getItem('ai-board-theme');
      var theme;
      if (saved === 'light' || saved === 'dark') {
        theme = saved;
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        theme = 'dark';
      } else {
        theme = 'light';
      }
      document.documentElement.setAttribute('data-theme', theme);
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>
<style>
:root{
  --paper:#f6f3ec;--paper-2:#fdfbf6;--ink:#1a1512;--ink-soft:#3d3630;
  --muted:#736b62;--faint:#a49a8e;--line:#ded6c8;--line-strong:#c4b9a8;
  --red:#9c2b22;--red-deep:#7a1f18;--red-glow:rgba(156,43,34,.12);
  --nav-bg:rgba(246,243,236,.97);--nav-shadow:0 2px 14px rgba(0,0,0,.08);
  --selection:rgba(156,43,34,.16);
  --toggle-bg:#ffffff;--toggle-border:#c4b9a8;
  --entry-hover:rgba(156,43,34,.04);
  --serif:"Source Han Serif SC","Noto Serif SC","Songti SC","STSong",Georgia,"Times New Roman",serif;
  --sans:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",sans-serif;
}
[data-theme="dark"]{
  /* 纸面：中性冷灰，不带黄调 */
  --paper:#1e1f22;
  --paper-2:#25272b;

  /* 文字：暖白 + 三级灰阶，靠明度拉层级 */
  --ink:#e8e6e1;
  --ink-soft:#c2bfb8;
  --muted:#8e8b85;
  --faint:#63615c;

  /* 分隔线：低对比，不抢视线 */
  --line:#2e3035;
  --line-strong:#3f4147;

  /* 强调色：降低饱和度，从“正红”退到“砖红” */
  --red:#c96b5a;
  --red-deep:#dd8a7b;
  --red-glow:rgba(201,107,90,.16);

  /* 今日高亮：极淡的暖灰粉，只做“标记”不做“色块” */
  --new-bg:#2a2524;

  /* 导航与交互 */
  --nav-bg:rgba(30,31,34,.94);
  --nav-shadow:0 2px 18px rgba(0,0,0,.45);
  --selection:rgba(201,107,90,.22);
  --toggle-bg:#2a2c30;
  --toggle-border:#3f4147;
  --entry-hover:rgba(201,107,90,.05);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--paper);color:var(--ink);
  font-family:var(--sans);font-size:15px;line-height:1.75;
  -webkit-font-smoothing:antialiased;
  transition:background-color .3s ease,color .3s ease;
}
::selection{background:var(--selection);}
a{color:inherit;text-decoration:none;}

/* ============ MASTHEAD ============ */
.masthead{max-width:1220px;margin:0 auto;padding:34px 36px 0;}
.masthead-top{
  display:flex;justify-content:space-between;align-items:baseline;gap:16px;
  padding-bottom:10px;border-bottom:1px solid var(--ink);
  font-size:10.5px;letter-spacing:.22em;text-transform:uppercase;
  color:var(--muted);font-weight:600;
}
.masthead-top .back{
  display:inline-flex;align-items:center;gap:6px;
  color:var(--red);letter-spacing:.06em;
  transition:color .2s;
}
.masthead-top .back:hover{color:var(--red-deep);}
.masthead h1{
  font-family:var(--serif);font-weight:700;
  font-size:clamp(30px,5.4vw,58px);line-height:1.05;
  letter-spacing:-.01em;padding:22px 0 16px;text-align:center;
}
.masthead h1 span{
  display:block;font-size:clamp(13px,2vw,18px);font-weight:400;
  letter-spacing:.42em;color:var(--red);margin-top:14px;text-indent:.42em;
}
.masthead-bottom{
  display:flex;justify-content:space-between;align-items:baseline;
  gap:16px;flex-wrap:wrap;padding:9px 0 10px;
  border-top:3px double var(--ink);border-bottom:1px solid var(--line-strong);
  font-size:11.5px;letter-spacing:.1em;color:var(--muted);
}
.masthead-bottom .stats{color:var(--ink-soft);font-weight:500;}
.masthead-bottom .stats b{color:var(--red);font-weight:700;}
.masthead-bottom .date{font-variant-numeric:tabular-nums;letter-spacing:.08em;}

/* ============ NAV ============ */
.nav{
  position:relative;z-index:100;
  background:var(--nav-bg);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line-strong);
  transition:box-shadow .3s;
}
.nav.is-fixed{position:fixed;top:0;left:0;right:0;box-shadow:var(--nav-shadow);}
.nav-outer{
  max-width:1220px;margin:0 auto;padding:0 36px;
  display:flex;align-items:center;
}
.nav-inner{
  flex:1;min-width:0;display:flex;gap:0;
  overflow-x:auto;scrollbar-width:none;
}
.nav-inner::-webkit-scrollbar{display:none;}
.nav a{
  flex:0 0 auto;position:relative;padding:13px 17px 12px;
  font-size:12.5px;letter-spacing:.06em;color:var(--muted);
  white-space:nowrap;transition:color .2s;cursor:pointer;
}
.nav a::after{
  content:'';position:absolute;left:17px;right:17px;bottom:0;height:2px;
  background:var(--red);transform:scaleX(0);transform-origin:left;
  transition:transform .28s cubic-bezier(.22,.61,.36,1);
}
.nav a:hover{color:var(--ink);}
.nav a.active{color:var(--ink);font-weight:600;}
.nav a.active::after{transform:scaleX(1);}

.theme-toggle{
  flex:0 0 auto;margin-left:10px;
  width:34px;height:34px;border-radius:50%;
  border:1px solid var(--toggle-border);
  background:var(--toggle-bg);color:var(--ink-soft);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  padding:0;transition:background-color .25s,border-color .25s,color .25s,transform .2s;
}
.theme-toggle:hover{color:var(--ink);border-color:var(--ink-soft);transform:scale(1.06);}
.theme-toggle:active{transform:scale(.95);}
.theme-toggle svg{width:16px;height:16px;display:block;}
.theme-toggle .icon-sun{display:none;}
.theme-toggle .icon-moon{display:block;}
[data-theme="dark"] .theme-toggle .icon-sun{display:block;}
[data-theme="dark"] .theme-toggle .icon-moon{display:none;}
.nav-spacer{height:0;}

/* ============ MAIN ============ */
main{max-width:1220px;margin:0 auto;padding:0 36px 90px;}
section{scroll-margin-top:70px;}

.archive-intro{
  margin:38px 0 0;padding:20px 26px;
  border-left:3px solid var(--red);
  background:var(--paper-2);
  font-size:13.5px;line-height:1.9;color:var(--ink-soft);
}
.archive-intro b{color:var(--ink);font-weight:700;}

/* ============ BOARD ============ */
.archive-board{
  margin-top:56px;
  --c:var(--c-light);
}
.archive-board-head{
  display:flex;align-items:baseline;gap:14px;
  padding-bottom:14px;margin-bottom:0;
  border-bottom:2px solid var(--ink);
}
.archive-board-num{
  font-family:var(--serif);font-size:12px;font-weight:700;
  letter-spacing:.12em;color:var(--red);
  font-variant-numeric:tabular-nums;
}
.archive-board-name{
  font-family:var(--serif);font-size:22px;font-weight:700;
  letter-spacing:-.005em;line-height:1.3;
}
.archive-board-count{
  margin-left:auto;
  font-size:11px;letter-spacing:.06em;color:var(--faint);
  font-variant-numeric:tabular-nums;
}
.archive-board-count b{color:var(--c);font-weight:700;}

.archive-list{
  border-top:1px solid var(--line-strong);
}

.entry{
  display:grid;
  grid-template-columns:72px 76px minmax(0,1fr) 28px;
  gap:18px;
  align-items:center;
  padding:13px 4px;
  border-bottom:1px solid var(--line);
  text-decoration:none;color:inherit;
  transition:background-color .18s;
}
.entry:hover{background:var(--entry-hover);}
.entry-date{
  font-size:12px;font-weight:600;
  letter-spacing:.02em;color:var(--faint);
  font-variant-numeric:tabular-nums;line-height:1.3;
}
.entry-date .yr{
  display:block;font-size:9.5px;
  letter-spacing:.08em;color:var(--faint);opacity:.7;
  margin-top:1px;
}
.entry-tag{
  display:inline-block;
  font-size:10.5px;font-weight:700;
  letter-spacing:.06em;color:var(--c);
  border:1px solid color-mix(in srgb,var(--c) 32%,transparent);
  padding:1px 7px;border-radius:1px;
  text-align:center;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;
}
.entry-title{
  font-family:var(--serif);
  font-size:15px;font-weight:500;
  line-height:1.6;
  color:var(--ink-soft);
  overflow:hidden;
  text-overflow:ellipsis;
  transition:color .18s;
}
.entry:hover .entry-title{color:var(--ink);}
.entry-arrow{
  font-size:13px;color:var(--faint);
  text-align:right;
  transition:transform .2s,color .2s;
}
.entry:hover .entry-arrow{
  color:var(--c);
  transform:translate(2px,-2px);
}
.archive-empty{
  padding:28px 4px;
  font-size:13px;color:var(--faint);
  border-bottom:1px solid var(--line);
}

/* ============ FOOTER ============ */
footer{
  max-width:1220px;margin:0 auto;padding:26px 36px 56px;
  border-top:1px solid var(--line-strong);
  display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;
  font-size:11px;letter-spacing:.08em;color:var(--faint);
}

/* ============ DARK MODE 板块色 ============ */
[data-theme="dark"] .archive-board{--c:var(--c-dark);}

/* ============ RESPONSIVE ============ */
@media(max-width:900px){
  .masthead{padding:26px 24px 0;}
  .nav-outer{padding:0 24px;}
  main{padding:0 24px 70px;}
  .masthead h1{padding:18px 0 14px;}
  .entry{grid-template-columns:64px 70px minmax(0,1fr) 24px;gap:12px;}
}
@media(max-width:640px){
  .masthead{padding:22px 18px 0;}
  .nav-outer{padding:0 18px;}
  main{padding:0 18px 56px;}
  .masthead-top{font-size:9px;letter-spacing:.16em;}
  .masthead-bottom{font-size:10.5px;}
  .archive-intro{padding:16px 18px;font-size:12.5px;line-height:1.85;}
  .archive-board{margin-top:44px;}
  .archive-board-name{font-size:18px;}
  .entry{
    grid-template-columns:1fr 24px;
    gap:6px 8px;
    padding:14px 4px;
  }
  .entry-date{
    grid-column:1/-1;
    font-size:11px;
    display:flex;gap:8px;align-items:baseline;
  }
  .entry-date .yr{margin-top:0;}
  .entry-tag{
    grid-column:1;
    font-size:10px;
    justify-self:start;
    margin-bottom:2px;
  }
  .entry-title{
    grid-column:1;
    font-size:14px;
    line-height:1.55;
  }
  .entry-arrow{
    grid-column:2;
    grid-row:2 / span 2;
    align-self:center;
    font-size:14px;
  }
  footer{padding:22px 18px 46px;font-size:10px;}
}
</style>
</head>
<body>

<header class="masthead">
  <div class="masthead-top">
    <span>AI Industry Intelligence · Archive</span>
    <a href="index.html" class="back">← 返回今日看板</a>
  </div>
  <h1>历史资讯归档<span>PAST BRIEFS · QUICK RECAP</span></h1>
  <div class="masthead-bottom">
    <span class="stats">共 <b>{{ total_entries }}</b> 条历史资讯 · 覆盖 <b>{{ date_range }}</b></span>
    <span class="date">{{ date_cn }}</span>
  </div>
</header>

<nav class="nav" id="mainNav">
  <div class="nav-outer">
    <div class="nav-inner">
      <a href="index.html">返回今日</a>
      {% for b in boards %}<a href="#{{ b.id }}">{{ b.name }}</a>{% endfor %}
    </div>
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="切换深浅模式" title="切换深浅模式">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
    </button>
  </div>
</nav>
<div class="nav-spacer" id="navSpacer"></div>

<main>

  <aside class="archive-intro">
    <b>快速回顾模式。</b>每条历史资讯只保留精炼后的一句话标题，不展示摘要与深度解析，方便按板块快速回看过去一段时间的产业走向。点击任一标题可在新标签页打开原文。
  </aside>

  {% for b in boards %}
  <section id="{{ b.id }}" class="archive-board" style="--c-light:{{ b.color }};--c-dark:{{ b.color_dark }}">
    <div class="archive-board-head">
      <span class="archive-board-num">{{ "%02d"|format(loop.index) }}</span>
      <span class="archive-board-name">{{ b.name }}</span>
      <span class="archive-board-count"><b>{{ b.entries|length }}</b> 条</span>
    </div>
    <div class="archive-list">
      {% for e in b.entries %}
      <a class="entry" href="{{ e.url }}" target="_blank" rel="noopener noreferrer" title="点击打开原文（来源：{{ e.source }}）">
        <span class="entry-date">{{ e.date_short }}<span class="yr">{{ e.year }}</span></span>
        <span class="entry-tag">{{ e.tag if e.tag else '动态' }}</span>
        <span class="entry-title">{{ e.title }}</span>
        <span class="entry-arrow">↗</span>
      </a>
      {% else %}
      <div class="archive-empty">本板块暂无历史资讯。</div>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

</main>

<footer>
  <div>AI产业情报局 · 历史资讯归档</div>
  <div>数据截至 {{ date_iso }} · 内容由 DeepSeek 自动生成，仅供参考，不构成投资建议</div>
</footer>

<script>
document.documentElement.classList.add('js');

/* ============ 主题切换 ============ */
(function(){
  var KEY = 'ai-board-theme';
  var root = document.documentElement;
  function toggle(){
    var cur = root.getAttribute('data-theme') || 'light';
    var next = cur === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem(KEY, next); } catch(e) {}
  }
  function bind(){
    var btn = document.getElementById('themeToggle');
    if(btn) btn.addEventListener('click', toggle);
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', bind);
  } else { bind(); }
})();

/* ============ 固定导航 ============ */
(function(){
  var nav = document.getElementById('mainNav');
  var spacer = document.getElementById('navSpacer');
  if(!nav || !spacer) return;
  var navTop = 0, navHeight = 0;
  function measure(){
    var wasFixed = nav.classList.contains('is-fixed');
    if(wasFixed) nav.classList.remove('is-fixed');
    navTop = nav.offsetTop;
    navHeight = nav.offsetHeight;
    spacer.style.height = navHeight + 'px';
    document.documentElement.style.scrollPaddingTop = navHeight + 'px';
    if(wasFixed) nav.classList.add('is-fixed');
    update();
  }
  function update(){
    if(window.scrollY >= navTop){
      nav.classList.add('is-fixed');
      spacer.style.height = navHeight + 'px';
    } else {
      nav.classList.remove('is-fixed');
      spacer.style.height = '0px';
    }
  }
  measure();
  window.addEventListener('load', measure);
  window.addEventListener('resize', measure);
  window.addEventListener('scroll', update, { passive: true });
})();

/* ============ 锚点平滑滚动 + 外链新标签页 ============ */
(function(){
  var nav = document.querySelector('.nav');
  var navLinks = document.querySelectorAll('.nav a');
  var sections = document.querySelectorAll('main section[id]');
  function smoothTo(id){
    var el = document.getElementById(id);
    if(!el) return;
    var nh = nav ? nav.offsetHeight : 0;
    var top = el.getBoundingClientRect().top + window.pageYOffset - nh;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }
  document.querySelectorAll('a[href]').forEach(function(a){
    a.addEventListener('click', function(e){
      var href = this.getAttribute('href');
      if(!href) return;
      if(href.charAt(0) === '#'){
        var id = href.slice(1);
        if(id && document.getElementById(id)){
          e.preventDefault();
          smoothTo(id);
          history.replaceState(null, '', '#' + id);
        }
        return;
      }
      if(/^https?:\/\//i.test(href)){
        e.preventDefault();
        e.stopPropagation();
        window.open(href, '_blank', 'noopener,noreferrer');
      }
    });
  });
  if('IntersectionObserver' in window){
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){
          var id = '#' + en.target.id;
          navLinks.forEach(function(a){
            a.classList.toggle('active', a.getAttribute('href') === id);
          });
        }
      });
    }, { rootMargin: '-40% 0px -55% 0px', threshold: 0 });
    sections.forEach(function(s){ obs.observe(s); });
  }
  window.addEventListener('load', function(){
    if(location.hash){
      var id = location.hash.slice(1);
      if(document.getElementById(id)){ setTimeout(function(){ smoothTo(id); }, 80); }
    }
  });
})();
</script>
</body>
</html>